# Keep APP_MODE=demo until every integration is configured.
APP_MODE=demo
PORT=4173
DATA_DIR=backend/data
FRONTEND_ORIGIN=https://alexjupiter.github.io
RP_ID=alexjupiter.github.io
# Generate separate random 32-byte secrets. Never put these in public/config.js.
SESSION_SECRET=
# Stable lifetime secret for passport uniqueness. Back up; changing it breaks deduplication.
PASSPORT_UNIQUENESS_SECRET=
REVIEW_WEBHOOK_SECRET=
REVIEWER_EMAILS=reviewer@example.org
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
# Optional transports: only needed if users choose email or WhatsApp.
# Application decisions and announcements always use the in-app inbox.
RESEND_API_KEY=
EMAIL_FROM=New Tibet <identity@your-verified-domain.org>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to a supported version shown in your Meta app dashboard.
META_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE=new_tibet_verification
WHATSAPP_REGISTRATION_TEMPLATE=new_tibet_registration
WHATSAPP_ACCEPTED_TEMPLATE=new_tibet_accepted
WHATSAPP_DECLINED_TEMPLATE=new_tibet_declined
# Only enable behind a proxy that overwrites X-Forwarded-For reliably.
TRUST_PROXY=0

# Optional Ethereum mainnet RPC used for local ZKPassport verification.
# No passport details or proofs are sent to the ZKPassport verifier API.
ZKPASSPORT_RPC_URL=

# Optional membership card QR checks and Apple/Google Wallet issuance.
# A stable, separate secret of at least 32 random characters.
MEMBERSHIP_CARD_SECRET=
# Full frontend base URL, including Pages repository path and trailing slash.
CARD_FRONTEND_URL=https://alexjupiter.github.io/new-tibet-app/
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERTIFICATE=/run/secrets/apple-pass-certificate.pem
APPLE_PASS_PRIVATE_KEY=/run/secrets/apple-pass-key.pem
APPLE_WWDR_CERTIFICATE=/run/secrets/apple-wwdr.pem
APPLE_PASS_KEY_PASSWORD=
GOOGLE_WALLET_ISSUER_ID=
# Existing approved Generic pass class: issuerID.className.
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_CREDENTIALS=/run/secrets/google-wallet-service-account.json
