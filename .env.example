# Keep APP_MODE=demo until every integration is configured.
APP_MODE=demo
PORT=4173
DATA_DIR=backend/data
FRONTEND_ORIGIN=https://alexjupiter.github.io
RP_ID=alexjupiter.github.io
# Generate separate random 32-byte secrets. Never put these in public/config.js.
SESSION_SECRET=
# Stable lifetime secret for passport uniqueness. Back up; changing it breaks deduplication.
PASSPORT_UNIQUENESS_SECRET=
REVIEW_WEBHOOK_SECRET=
REVIEWER_EMAILS=reviewer@example.org
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
RESEND_API_KEY=
EMAIL_FROM=New Tibet <identity@your-verified-domain.org>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to a supported version shown in your Meta app dashboard.
META_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE=new_tibet_verification
WHATSAPP_REGISTRATION_TEMPLATE=new_tibet_registration
WHATSAPP_ACCEPTED_TEMPLATE=new_tibet_accepted
WHATSAPP_DECLINED_TEMPLATE=new_tibet_declined
# Only enable behind a proxy that overwrites X-Forwarded-For reliably.
TRUST_PROXY=0

# Optional Ethereum mainnet RPC used for local ZKPassport verification.
# No passport details or proofs are sent to the ZKPassport verifier API.
ZKPASSPORT_RPC_URL=
