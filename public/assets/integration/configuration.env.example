# Integration preview. New Tibet has not issued these credentials.
# Replace the reserved .example URLs only after onboarding.
NEW_TIBET_ISSUER=https://identity.newtibet.example
NEW_TIBET_CLIENT_ID=replace-with-your-client-id
NEW_TIBET_CLIENT_SECRET=replace-with-your-server-secret
NEW_TIBET_REDIRECT_URI=https://your-app.example/auth/new-tibet/callback

# Proposed scope; confirm the final scope during onboarding.
NEW_TIBET_MEMBERSHIP_SCOPE=membership
